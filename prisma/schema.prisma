generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  inwardEntries InwardEntry[]
  packingSlips  PackingSlip[]
}

// ─── Master Tables ────────────────────────────────────────────────────────────

model Party {
  id            Int           @id @default(autoincrement())
  code          String?       @unique
  name          String
  address       String?
  phone         String?
  gstNo         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  inwardEntries InwardEntry[]
  packingSlips  PackingSlip[]
  projects      Project[]     @relation("ProjectParty")
  pos           PO[]
}

model Project {
  id            Int           @id @default(autoincrement())
  code          String?       @unique
  name          String
  description   String?
  partyId       Int?
  party         Party?        @relation("ProjectParty", fields: [partyId], references: [id])
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  inwardEntries InwardEntry[]
  packingSlips  PackingSlip[]
  pos           PO[]
}

model Product {
  id               Int               @id @default(autoincrement())
  productCode      String            @unique
  productName      String
  specification    String?
  description      String?
  businessLine     String?
  hsnCode          String?
  uom              String?
  // Default bundle fields (optional); pre-fill new packing slip lines from item master
  defaultBundleQty   Int?
  defaultNoOfBundles Int?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  inwardEntries    InwardEntry[]
  packingSlipItems PackingSlipItem[]
  packingSlipSummaries PackingSlipProductSummary[]
}

model PO {
  id            Int           @id @default(autoincrement())
  poNumber      String        @unique
  imageLink     String?
  date          DateTime?
  partyId       Int?
  party         Party?        @relation(fields: [partyId], references: [id])
  projectId     Int?
  project       Project?      @relation(fields: [projectId], references: [id])
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  inwardEntries InwardEntry[]
  packingSlips  PackingSlip[]
}

// ─── Transaction Tables ───────────────────────────────────────────────────────

model InwardEntry {
  id              Int       @id @default(autoincrement())
  srNo            Int       @default(autoincrement())
  date            DateTime
  challan         String

  // Required FKs — no denormalized name strings
  partyId         Int
  party           Party     @relation(fields: [partyId], references: [id])
  productId       Int
  product         Product   @relation(fields: [productId], references: [id])

  // Optional FKs
  projectId       Int?
  project         Project?  @relation(fields: [projectId], references: [id])
  poId            Int?
  poRef           PO?       @relation(fields: [poId], references: [id])
  createdById     Int?
  createdBy       User?     @relation(fields: [createdById], references: [id])

  // Entry-specific data
  inwardQty       Int
  kg              Float?
  specification   String?
  businessLine    String?
  challanDays     Int?
  dcLink          String?
  remarks         String?
  year            String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

// ─── Packing Slip: header + line items ───────────────────────────────────────

model PackingSlip {
  id          Int               @id @default(autoincrement())
  slipNo      String            @unique
  date        DateTime

  // Required FK — party is mandatory on a packing slip
  partyId     Int
  party       Party             @relation(fields: [partyId], references: [id])

  // Optional FKs
  projectId   Int?
  project     Project?          @relation(fields: [projectId], references: [id])
  poId        Int?
  poRef       PO?               @relation(fields: [poId], references: [id])
  createdById Int?
  createdBy   User?             @relation(fields: [createdById], references: [id])

  remarks              String?
  vehicleNo            String?
  slipWeight           Float?
  finalBillableWeight  Float?
  packagingWeightPerPc Float?
  packagingQty         Int?
  isLocked             Boolean           @default(false)
  printedAt            DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  items       PackingSlipItem[]
  productSummaries PackingSlipProductSummary[]
}

model PackingSlipItem {
  id            Int         @id @default(autoincrement())
  packingSlipId Int
  packingSlip   PackingSlip @relation(fields: [packingSlipId], references: [id], onDelete: Cascade)

  // Required FK — every item line must reference a product
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])

  // Per-line data
  dcLink        String?
  specification String?
  businessLine  String?
  qty           Int
  kg            Float?
  // Bundle tracking
  bundleQty     Int?
  noOfBundles   Int?
  // Per-row packaging / weight
  packagingWeightPerPc Float?
  packagingQty         Int?
  slipWeight           Float?
  finalBillableWeight  Float?

  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
}

model PackingSlipProductSummary {
  id                   Int         @id @default(autoincrement())
  packingSlipId        Int
  packingSlip          PackingSlip @relation(fields: [packingSlipId], references: [id], onDelete: Cascade)
  productId            Int
  product              Product     @relation(fields: [productId], references: [id])
  
  slipWeight           Float?
  packagingWeightPerPc Float?
  packagingQty         Int?
  finalBillableWeight  Float?
  
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([packingSlipId, productId])
}
